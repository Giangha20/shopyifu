# ===================================
# LUXE SHOP - Environment Configuration
# ===================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===================================
# DATABASE
# ===================================
DATABASE_URL="postgresql://user:password@localhost:5432/luxe_shop?schema=public"

# ===================================
# AUTHENTICATION
# ===================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ===================================
# GOOGLE OAUTH (Optional)
# ===================================
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ===================================
# EMAIL SERVICE (Optional)
# ===================================
# Supported: smtp, resend, sendgrid
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="noreply@luxeshop.vn"

# For Resend (recommended):
# RESEND_API_KEY=""

# ===================================
# FILE STORAGE
# ===================================
# local: Store in ./uploads directory
# s3: Use S3-compatible storage
STORAGE_PROVIDER="local"
UPLOAD_MAX_SIZE_MB="10"

# S3-Compatible Storage (Optional)
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_PUBLIC_URL=""

# ===================================
# PAYMENT GATEWAYS
# ===================================
# VNPay
# VNPAY_TMN_CODE=""
# VNPAY_HASH_SECRET=""
# VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# VNPAY_RETURN_URL="http://localhost:3000/api/payment/vnpay/return"

# MoMo
# MOMO_PARTNER_CODE=""
# MOMO_ACCESS_KEY=""
# MOMO_SECRET_KEY=""
# MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api"

# ===================================
# APPLICATION SETTINGS
# ===================================
NEXT_PUBLIC_APP_NAME="LUXE SHOP"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DESCRIPTION="Thời trang cao cấp & phong cách sống"

# Rate limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Session
SESSION_MAX_AGE="86400"
ADMIN_SESSION_MAX_AGE="28800"

# ===================================
# INITIAL ADMIN SETUP
# ===================================
# Used ONLY during first-time setup via: npm run db:seed
# Change or remove after initial setup
ADMIN_EMAIL="admin@luxeshop.vn"
ADMIN_PASSWORD="ChangeMeImmediately!2024"

# ===================================
# MONITORING (Optional)
# ===================================
# SENTRY_DSN=""
# LOG_LEVEL="info"
